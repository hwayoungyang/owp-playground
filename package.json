{
  "name": "owp-playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm knowledge:generate && vp dev --host 127.0.0.1 --open",
    "build": "pnpm knowledge:generate && tsc --noEmit && vp build",
    "knowledge:generate": "node --experimental-strip-types scripts/generate-knowledge.mjs",
    "knowledge:check": "node --experimental-strip-types scripts/generate-knowledge.mjs --check",
    "knowledge:audit": "node scripts/audit-knowledge-sources.mjs",
    "snapshot:create": "node --experimental-strip-types scripts/snapshot-playground.mjs",
    "mcp:stdio": "node --experimental-strip-types mcp/cli.ts --transport stdio",
    "mcp:http": "node --experimental-strip-types mcp/cli.ts --transport http",
    "deploy": "node scripts/deploy-playground.mjs",
    "deploy:preflight": "node scripts/deploy-playground.mjs --preflight-only",
    "deploy:mcp": "node --experimental-strip-types scripts/deploy-mcp.mjs",
    "deploy:mcp:preflight": "node --experimental-strip-types scripts/deploy-mcp.mjs --preflight-only",
    "deploy:rollback": "node scripts/deploy-operations.mjs rollback",
    "deploy:status": "node scripts/deploy-operations.mjs status",
    "deploy:cleanup": "node scripts/deploy-operations.mjs cleanup",
    "test:deploy": "node --test scripts/test/deploy-*.test.mjs",
    "test:deploy:mcp": "node --experimental-strip-types --test scripts/test/deploy-mcp*.test.mjs",
    "preview": "vp preview --host 127.0.0.1 --open",
    "typecheck": "tsc --noEmit",
    "check": "vp check && pnpm check:assets",
    "test": "vp test run && node --test scripts/test/*.test.mjs",
    "test:browser": "node scripts/verify.mjs",
    "test:locales": "node scripts/verify-locales.mjs",
    "test:navigation": "node scripts/verify-navigation.mjs",
    "test:api": "node scripts/verify-api.mjs",
    "audit:browser": "node scripts/audit.mjs",
    "test:charts": "node scripts/verify-charts.mjs",
    "test:chartjs": "node scripts/verify-chartjs.mjs",
    "test:sources": "node scripts/verify-source-structure.mjs --static",
    "lint": "vp lint && pnpm check:assets",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "check:assets": "biome lint ."
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@mui/material": "^9.5.0",
    "@mui/system": "^9.5.0",
    "@owp/charts": "6.0.0",
    "@owp/components": "4.0.0",
    "@owp/core": "10.2.0",
    "@owp/datagrid": "3.5.3",
    "@owp/date-picker": "2.0.4",
    "@owp/excel": "3.0.0",
    "@owp/pdf": "3.0.0",
    "@owp/theme": "3.0.0",
    "@owp/utils": "1.1.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.104.5",
    "chartjs-adapter-luxon": "^1.3.1",
    "highlight.js": "^11.12.0",
    "i18next": "^26.5.11",
    "luxon": "^3.7.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^17.1.9",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7",
    "chart.js": "^4.5.1",
    "chartjs-plugin-datalabels": "^2.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.5.15",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsonc-parser": "^3.3.1",
    "lighthouse": "^13.5.0",
    "playwright": "^1.64.1",
    "playwright-lighthouse": "^4.0.0",
    "react-grab": "^0.2.0",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.15.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  }
}
