{
  "name": "owp-playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "test": "vitest run",
    "test:browser": "node scripts/verify.mjs",
    "test:locales": "node scripts/verify-locales.mjs",
    "test:navigation": "node scripts/verify-navigation.mjs",
    "test:api": "node scripts/verify-api.mjs",
    "audit:browser": "node scripts/audit.mjs",
    "doctor": "react-doctor . --verbose",
    "test:charts": "node scripts/verify-charts.mjs",
    "test:chartjs": "node scripts/verify-chartjs.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/geist-mono": "^5.2.7",
    "@mui/material": "^9.4.0",
    "@mui/system": "^9.4.0",
    "@owp/charts": "3.1.1",
    "@owp/components": "1.0.0",
    "@owp/core": "5.0.1",
    "@owp/datagrid": "2.0.11",
    "@owp/date-picker": "1.0.1",
    "@owp/excel": "1.1.1",
    "@owp/pdf": "1.1.1",
    "@owp/theme": "1.0.0",
    "@phosphor-icons/react": "^2.1.10",
    "highlight.js": "^11.11.1",
    "i18next": "^26.4.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.16",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.3.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "lighthouse": "^13.5.0",
    "playwright": "^1.64.0",
    "playwright-lighthouse": "^4.0.0",
    "react-doctor": "latest",
    "react-grab": "latest",
    "react-scan": "latest",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.0.0"
  },
  "packageManager": "pnpm@10.20.0"
}
