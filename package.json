{
  "name": "owp-playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev --host 127.0.0.1 --open",
    "build": "tsc --noEmit && vp build",
    "preview": "vp preview --host 127.0.0.1 --open",
    "typecheck": "tsc --noEmit",
    "check": "vp check && pnpm check:assets",
    "test": "vp test run && node --test scripts/test/*.test.mjs",
    "test:browser": "node scripts/verify.mjs",
    "test:locales": "node scripts/verify-locales.mjs",
    "test:navigation": "node scripts/verify-navigation.mjs",
    "test:api": "node scripts/verify-api.mjs",
    "audit:browser": "node scripts/audit.mjs",
    "test:charts": "node scripts/verify-charts.mjs",
    "test:chartjs": "node scripts/verify-chartjs.mjs",
    "test:sources": "node scripts/verify-source-structure.mjs --static",
    "lint": "vp lint && pnpm check:assets",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "check:assets": "biome lint ."
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@mui/material": "^9.5.0",
    "@mui/system": "^9.5.0",
    "@owp/charts": "4.0.3",
    "@owp/components": "2.0.0",
    "@owp/core": "6.0.1",
    "@owp/datagrid": "3.0.1",
    "@owp/date-picker": "2.0.0",
    "@owp/excel": "2.0.0",
    "@owp/pdf": "2.0.0",
    "@owp/theme": "2.0.0",
    "@phosphor-icons/react": "^2.1.10",
    "highlight.js": "^11.12.0",
    "i18next": "^26.4.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.0.20",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsonc-parser": "^3.3.1",
    "lighthouse": "^13.5.0",
    "playwright": "^1.64.1",
    "playwright-lighthouse": "^4.0.0",
    "react-grab": "^0.2.0",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  }
}
