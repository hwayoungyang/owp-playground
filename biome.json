{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "src/**/*.{css,json,jsonc,html}",
      "!src/features/api/data/*.generated.json",
      "tests/**/*.{css,json,jsonc,html}",
      "*.json",
      "index.html"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "enabled": false
  }
}
